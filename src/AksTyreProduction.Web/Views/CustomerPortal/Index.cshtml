@model CustomerProgressDto
@{ViewData["Title"]="Customer Portal";}
<div style="max-width:900px;margin:auto"><div class="text-center mb-4"><h1>Track Your Tyre</h1><p class="muted">Enter the AKS tyre ID or manufacturer serial number</p></div><form method="get" class="scan-box mb-4"><div class="input-group"><input name="q" class="form-control form-control-lg" value="@Context.Request.Query["q"]" placeholder="GTC260001 or ABC123456"/><button class="btn btn-primary px-4">Track Progress</button></div></form>@if(ViewBag.Error!=null){<div class="alert alert-warning">@ViewBag.Error</div>}@if(Model!=null){<div class="card"><div class="card-body p-4"><div class="d-flex justify-content-between flex-wrap mb-4"><div><small class="muted">AKS TYRE</small><h2>@Model.AksTyreId</h2><p>@Model.Brand @Model.Size · Serial @Model.SerialNumber<br/>@Model.Customer · Retread #@Model.RetreadNumber</p>@if(Model.EstimatedCompletion.HasValue){<p><strong>Estimated completion:</strong> @Model.EstimatedCompletion.Value.ToString("dd MMMM yyyy HH:mm")</p>}</div><span class="status-pill h-100">@Model.CurrentStage</span></div>@if(Model.CurrentStage=="Rejected"){<div class="alert alert-warning mb-4">This tyre has been rejected and requires a manual review before it can proceed.</div>}<h5>Production Progress</h5>@foreach(var stage in Workflow.Stages){var done=Model.CompletedStages.Contains(stage)||stage=="Dispatch"&&Model.CurrentStage=="Dispatched";var current=stage==Model.CurrentStage;<div class="d-flex justify-content-between border-bottom py-3"><span>@stage</span><strong class="@(done?"text-success":current?"text-warning":"text-secondary")">@(done?"✓ Complete":current?"● In Progress":"Pending")</strong></div>}<div class="alert alert-light border mt-4 mb-0">This customer view intentionally excludes internal costs, labour rates, margins, and confidential production notes.</div></div></div>}</div>
