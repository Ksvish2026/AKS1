@model List<Material>
@{ViewData["Title"]="Materials";string R(decimal v)=>v.ToString("C2",CultureInfo.GetCultureInfo("en-ZA"));var canEdit = User.IsInRole(ApplicationRoles.Administrator) || User.IsInRole(ApplicationRoles.Management);}
<div class="page-head"><div><h1>Materials & Inventory</h1><p>Current stock, prices, reorder levels, and batch controls</p></div><a class="btn btn-outline-primary" asp-action="Traceability">Batch Traceability</a></div><div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>ID / Material</th><th>Category</th><th>Unit</th><th>Unit Cost</th><th>On Hand</th><th>Reorder</th><th>Batches</th><th></th></tr></thead><tbody>@foreach(var m in Model){<tr class="@(m.QuantityOnHand<=m.ReorderLevel?"table-warning":"")"><td>@m.MaterialId<br/><strong>@m.Name</strong></td><td>@m.Category</td><td>@m.UnitOfMeasure</td>@if(canEdit){<td colspan="3"><form asp-action="Update" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@m.Id"/><input name="currentUnitCost" value="@m.CurrentUnitCost" type="number" step="0.01" class="form-control form-control-sm" title="Unit cost"/><input name="quantityOnHand" value="@m.QuantityOnHand" type="number" step="0.01" class="form-control form-control-sm" title="On hand"/><input name="reorderLevel" value="@m.ReorderLevel" type="number" step="0.01" class="form-control form-control-sm" title="Reorder"/><button class="btn btn-sm btn-outline-primary">Save</button></form></td>}else{<td>@R(m.CurrentUnitCost)</td><td>@m.QuantityOnHand</td><td>@m.ReorderLevel</td>}<td>@string.Join(", ",m.Batches.Select(x=>x.LotNumber))</td><td>@if(m.QuantityOnHand<=m.ReorderLevel){<span class="badge text-bg-warning">REORDER</span>}</td></tr>}</tbody></table></div></div>
