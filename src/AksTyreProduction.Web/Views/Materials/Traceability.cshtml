@model List<MaterialUsage>
@{ViewData["Title"]="Batch Traceability";}
<div class="page-head"><div><h1>Material Batch Traceability</h1><p>Find every tyre affected by a material batch</p></div></div><form method="get" class="scan-box mb-4"><label class="form-label fw-bold">BATCH / LOT NUMBER</label><div class="input-group"><input class="form-control form-control-lg" name="lot" value="@ViewBag.Lot" placeholder="Try CG-260912"/><button class="btn btn-primary">Trace Batch</button></div></form>@if(Model.Any()){<div class="card"><div class="card-header">Affected Tyres · @ViewBag.Lot</div><table class="table mb-0"><thead><tr><th>Tyre</th><th>Customer</th><th>Retread</th><th>Material</th><th>Quantity</th><th>Used</th></tr></thead><tbody>@foreach(var u in Model){<tr><td><a asp-controller="Tyres" asp-action="Details" asp-route-id="@u.RetreadJob.TyreId">@u.RetreadJob.Tyre.AksTyreId</a></td><td>@u.RetreadJob.Tyre.Customer.Name</td><td>#@u.RetreadJob.RetreadNumber</td><td>@u.Material.Name</td><td>@u.Quantity @u.Material.UnitOfMeasure</td><td>@u.UsedAt.ToString("dd MMM yyyy")</td></tr>}</tbody></table></div>}
