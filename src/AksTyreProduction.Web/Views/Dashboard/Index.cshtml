@model DashboardVm
@{ViewData["Title"]="Management Dashboard";string R(decimal v)=>v.ToString("C2",CultureInfo.GetCultureInfo("en-ZA"));}
<div class="page-head"><div><h1>Production Dashboard</h1><p>Live operational overview · @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p></div><a class="btn btn-warning" asp-controller="Tyres" asp-action="Receive">+ Receive Tyre</a></div>
<div class="kpi-grid"><div class="kpi"><div class="bar"></div><small>Received Today</small><strong>@Model.ReceivedToday</strong></div><div class="kpi"><div class="bar"></div><small>In Production</small><strong>@Model.InProduction</strong></div><div class="kpi"><div class="bar"></div><small>Completed</small><strong>@Model.Completed</strong></div><div class="kpi bad"><div class="bar"></div><small>Rejected</small><strong>@Model.Rejected</strong></div><div class="kpi warn"><div class="bar"></div><small>Awaiting Repair</small><strong>@Model.AwaitingRepair</strong></div><div class="kpi warn"><div class="bar"></div><small>Awaiting QC</small><strong>@Model.AwaitingQc</strong></div><div class="kpi"><div class="bar"></div><small>Ready Dispatch</small><strong>@Model.ReadyForDispatch</strong></div></div>
<div class="alert alert-info"><strong>Current bottleneck:</strong> @Model.Bottleneck</div>
<div class="grid-2 mb-4"><section class="card"><div class="card-header">Current WIP by Station</div><div class="card-body">@foreach(var row in Model.Wip.OrderByDescending(x=>x.Value)){<div class="d-flex align-items-center gap-3 mb-3"><div style="width:160px">@row.Key</div><div class="progress flex-grow-1" style="height:9px"><div class="progress-bar" style="width:@(Math.Min(100,row.Value*12))%"></div></div><strong>@row.Value</strong></div>}</div></section><section class="card"><div class="card-header">Production Costs</div><div class="card-body">@foreach(var row in Model.MaterialCostsByCategory.OrderBy(x=>x.Key)){<div class="d-flex justify-content-between mb-1"><span>@row.Key</span><span class="money">@R(row.Value)</span></div>}<div class="d-flex justify-content-between mb-2"><span>All Materials</span><span class="money">@R(Model.MaterialCost)</span></div><div class="d-flex justify-content-between mb-2"><span>Labour</span><span class="money">@R(Model.LabourCost)</span></div><hr/><div class="d-flex justify-content-between"><strong>Total Production Cost</strong><strong class="money text-primary">@R(Model.TotalCost)</strong></div></div></section></div>
<div class="grid-2 mb-4"><section class="card"><div class="card-header">Recent Activity</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Tyre</th><th>Station</th><th>Operator</th><th>Result</th><th>Duration</th></tr></thead><tbody>@foreach(var tx in Model.Recent){<tr><td><a asp-controller="Tyres" asp-action="Details" asp-route-id="@tx.RetreadJob.TyreId">@tx.RetreadJob.Tyre.AksTyreId</a></td><td>@tx.Station</td><td>@tx.Operator?.Name</td><td>@tx.Result</td><td>@tx.DurationMinutes min</td></tr>}</tbody></table></div></section><section class="card"><div class="card-header">Station Performance</div><div class="card-body">@foreach(var row in Model.AverageMinutes.OrderBy(x=>x.Key)){<div class="d-flex justify-content-between border-bottom py-2"><span>@row.Key</span><strong>@row.Value min avg.</strong></div>}<h6 class="mt-3">Requires attention</h6>@foreach(var job in Model.Attention){<a class="d-flex justify-content-between text-decoration-none py-1" asp-controller="Tyres" asp-action="Details" asp-route-id="@job.TyreId"><span>@job.Tyre.AksTyreId</span><span class="text-danger">@job.CurrentStage</span></a>}</div></section></div>
<div class="grid-2"><section class="card"><div class="card-header">Operator Productivity · Completed Transactions</div><div class="card-body">@foreach(var row in Model.OperatorProductivity.OrderByDescending(x=>x.Value)){<div class="d-flex justify-content-between border-bottom py-2"><span>@row.Key</span><strong>@row.Value jobs</strong></div>}</div></section><section class="card"><div class="card-header">Machine Utilisation · Recorded Minutes</div><div class="card-body">@foreach(var row in Model.MachineUtilisationMinutes.OrderByDescending(x=>x.Value)){<div class="d-flex justify-content-between border-bottom py-2"><span>@row.Key</span><strong>@row.Value.ToString("N0") min</strong></div>}</div></section></div>
