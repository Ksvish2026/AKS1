<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>@ViewData["Title"] - AKS Tyre</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body><div class="app-shell"><aside class="sidebar"><div class="brand"><span class="brand-mark">AKS</span><div><strong>TYRE PRODUCTION</strong><small>Tracking System</small></div></div><nav>
<a asp-controller="Dashboard" asp-action="Index">▦ <span>Dashboard</span></a><a asp-controller="Tyres" asp-action="Receive">＋ <span>Tyre Receiving</span></a><a asp-controller="Tyres" asp-action="Index">⌕ <span>Tyre Search</span></a><div class="nav-label">PRODUCTION</div>
@foreach(var s in Workflow.Stages.Where(x=>x!="Receiving"&&x!="Dispatch")){<a asp-controller="Stations" asp-action="Index" asp-route-station="@s"><span class="nav-dot"></span><span>@s</span></a>}
<a asp-controller="Stations" asp-action="Index" asp-route-station="Dispatch">⇥ <span>Dispatch</span></a><div class="nav-label">MANAGEMENT</div><a asp-controller="Customers" asp-action="Index">♙ <span>Customers</span></a><a asp-controller="Materials" asp-action="Index">▧ <span>Materials</span></a><a asp-controller="Materials" asp-action="Traceability">⌁ <span>Batch Traceability</span></a><a asp-controller="Invoices" asp-action="Index">R <span>Invoices</span></a><a asp-controller="Admin" asp-action="Index">⚙ <span>Operators & Machines</span></a><a asp-controller="CustomerPortal" asp-action="Index">◎ <span>Customer Portal</span></a></nav></aside>
<main><header class="topbar"><button class="mobile-menu" onclick="document.querySelector('.sidebar').classList.toggle('open')">☰</button><div><strong>AKS Manufacturing</strong><small>Signed in as @User.Identity?.Name</small></div><div class="d-flex align-items-center gap-2">@{var userRoles = User.Claims.Where(x => x.Type == System.Security.Claims.ClaimTypes.Role).Select(x => x.Value).Distinct().OrderBy(x => x).ToArray();var selectedRole = User.Claims.FirstOrDefault(x => x.Type == "SelectedRole")?.Value ?? userRoles.FirstOrDefault() ?? ApplicationRoles.Administrator;}<form asp-controller="Role" asp-action="Switch" method="post" class="role d-flex align-items-center gap-2"><span class="online"></span><input type="hidden" name="returnUrl" value="@(Context.Request.Path+Context.Request.QueryString)"/><select name="role" class="form-select form-select-sm" onchange="this.form.submit()">@foreach(var role in userRoles){if(selectedRole == role){<option value="@role" selected>@role</option>}else{<option value="@role">@role</option>}}</select></form><form asp-controller="Login" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-secondary">Sign out</button></form></div></header><div class="content">
@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}@if(TempData["Error"] is string err){<div class="alert alert-danger">@err</div>}@RenderBody()</div></main></div><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
