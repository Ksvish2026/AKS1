@model List<Invoice>
@{ViewData["Title"]="Invoices";string R(decimal v)=>v.ToString("C2",CultureInfo.GetCultureInfo("en-ZA"));}
<div class="page-head"><div><h1>Invoice Preparation</h1><p>Draft values generated from traceable tyre production costs</p></div></div><div class="card"><table class="table mb-0"><thead><tr><th>Invoice</th><th>Tyre</th><th>Customer</th><th>Production Cost</th><th>Markup</th><th>Selling Price</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.InvoiceNumber<br/><small>@x.CreatedAt.ToString("dd MMM yyyy")</small></td><td><a asp-controller="Tyres" asp-action="Details" asp-route-id="@x.RetreadJob.TyreId">@x.RetreadJob.Tyre.AksTyreId</a></td><td>@x.RetreadJob.Tyre.Customer.Name</td><td>@R(x.ProductionCostSnapshot)</td><td>@x.MarkupPercentSnapshot%</td><td class="fw-bold">@R(x.SellingPriceSnapshot)</td><td><span class="status-pill">@x.Status</span></td></tr>}</tbody></table></div>
