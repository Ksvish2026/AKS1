@model ReceiveVm
@{ViewData["Title"]="Receive Tyre";var customers=(List<Customer>)ViewBag.Customers;}
<div class="page-head"><div><h1>Receive Tyre</h1><p>Create a permanent tyre identity, printable tag, and Retread #1</p></div></div>
<div class="grid-2"><section class="card"><div class="card-header">Existing Tyre Return</div><div class="card-body"><p class="muted">Scan the permanent AKS tag to view its lifetime history and start the next retread.</p><form asp-action="Index" method="get"><div class="input-group"><input class="form-control form-control-lg" name="q" placeholder="e.g. GTC260001"/><button class="btn btn-outline-primary">Find Tyre</button></div></form></div></section><section class="card"><div class="card-header">Create New Tyre & Tag</div><div class="card-body"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label class="form-label">Customer / account / site</label><select asp-for="CustomerId" class="form-select mb-3"><option value="">Select customer...</option>@foreach(var c in customers){<option value="@c.Id">@c.Name · @c.AccountNumber · @c.Site</option>}</select><div class="row g-2"><div class="col-6"><label class="form-label">Brand</label><input asp-for="Brand" class="form-control"/></div><div class="col-6"><label class="form-label">Size</label><input asp-for="Size" class="form-control"/></div><div class="col-6"><label class="form-label">Serial number</label><input asp-for="SerialNumber" class="form-control"/></div><div class="col-6"><label class="form-label">Original tread pattern</label><input asp-for="OriginalTreadPattern" class="form-control"/></div><div class="col-6"><label class="form-label">Casing condition</label><select asp-for="CasingCondition" class="form-select"><option>Good</option><option>Fair</option><option>Requires inspection</option><option>Damaged</option></select></div><div class="col-6"><label class="form-label">Type / application</label><input asp-for="Application" class="form-control" placeholder="Long haul / regional"/></div><div class="col-6"><label class="form-label">Job / order number</label><input asp-for="JobNumber" class="form-control"/></div><div class="col-6"><label class="form-label">Estimated completion</label><input asp-for="EstimatedCompletion" type="datetime-local" class="form-control"/></div></div><button class="btn btn-primary mt-4 w-100">GENERATE AKS ID & RECEIVE</button></form></div></section></div>
