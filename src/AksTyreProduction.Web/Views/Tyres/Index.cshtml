@model List<Tyre>
@{ViewData["Title"]="Tyre Search";}
<div class="page-head"><div><h1>Tyre Search</h1><p>Search permanent identities and lifetime records</p></div><a class="btn btn-primary" asp-action="Receive">Create New Tyre</a></div>
<form class="scan-box mb-4" method="get"><label class="form-label fw-bold">SCAN OR SEARCH</label><div class="input-group"><input class="form-control form-control-lg" name="q" value="@ViewBag.Query" autofocus placeholder="AKS ID, serial, customer, account or job number"/><button class="btn btn-primary px-4">Search</button></div></form>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>AKS ID</th><th>Tyre</th><th>Serial</th><th>Customer</th><th>Retreads</th><th>Current Stage</th><th></th></tr></thead><tbody>@foreach(var tyre in Model){var job=tyre.RetreadJobs.OrderByDescending(x=>x.RetreadNumber).FirstOrDefault();<tr><td class="fw-bold">@tyre.AksTyreId</td><td>@tyre.Brand @tyre.Size</td><td>@tyre.SerialNumber</td><td>@tyre.Customer.Name</td><td>@tyre.RetreadJobs.Count</td><td><span class="badge badge-stage">@job?.CurrentStage</span></td><td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@tyre.Id">Passport →</a></td></tr>}</tbody></table></div></div>
