@{ViewData["Title"]="Operators & Machines";var ops=(List<Operator>)ViewBag.Operators;var machines=(List<Machine>)ViewBag.Machines;var audits=(List<AuditEvent>)ViewBag.Audits;}
<div class="page-head"><div><h1>Production Resources</h1><p>Manage demo operators and machines; review audited activity</p></div><span class="status-pill">Administrator</span></div>
<div class="grid-2 mb-4"><div class="card"><div class="card-header">Add Operator</div><div class="card-body"><form asp-action="AddOperator" method="post" class="row g-2"><div class="col-4"><input name="employeeId" class="form-control" required placeholder="OP006"/></div><div class="col-8"><input name="name" class="form-control" required placeholder="Name"/></div><div class="col-7"><input name="role" class="form-control" required placeholder="Role"/></div><div class="col-3"><input name="labourRate" type="number" step="0.01" class="form-control" required placeholder="Rate"/></div><div class="col-2"><button class="btn btn-primary">Add</button></div></form></div></div><div class="card"><div class="card-header">Add Machine</div><div class="card-body"><form asp-action="AddMachine" method="post" class="row g-2"><div class="col-3"><input name="machineId" class="form-control" required placeholder="CUR-04"/></div><div class="col-5"><input name="name" class="form-control" required placeholder="Machine name"/></div><div class="col-3"><input name="type" class="form-control" required placeholder="Type"/></div><div class="col-1"><button class="btn btn-primary">Add</button></div></form></div></div></div>
<div class="grid-2 mb-4"><div class="card"><div class="card-header">Operators & Current Rates</div><table class="table mb-0"><thead><tr><th>ID</th><th>Name</th><th>Role</th><th>Current Rate</th></tr></thead><tbody>@foreach(var op in ops){<tr><td>@op.EmployeeId</td><td>@op.Name</td><td>@op.Role</td><td>R @op.LabourRate.ToString("N2") / hr</td></tr>}</tbody></table></div><div class="card"><div class="card-header">Machines</div><table class="table mb-0"><thead><tr><th>ID</th><th>Name</th><th>Type</th><th>Status</th></tr></thead><tbody>@foreach(var m in machines){<tr><td>@m.MachineId</td><td>@m.Name</td><td>@m.Type</td><td><span class="status-pill">@m.Status</span></td></tr>}</tbody></table></div></div>
<div class="card"><div class="card-header">Audit Trail</div><table class="table mb-0"><thead><tr><th>Time</th><th>User</th><th>Action</th><th>Previous</th><th>New Value</th></tr></thead><tbody>@foreach(var a in audits){<tr><td>@a.OccurredAt.ToString("dd MMM HH:mm")</td><td>@a.User</td><td>@a.Action</td><td>@a.OldValue</td><td>@a.NewValue</td></tr>}</tbody></table></div>
