@model List<Customer>
@{ViewData["Title"]="Customers";}
<div class="page-head"><div><h1>Customers & Sites</h1><p>Account, address, division/site, and tyre relationships</p></div></div><div class="card mb-4"><div class="card-header">Add Customer</div><div class="card-body"><form asp-action="Save" method="post" class="row g-2"><div class="col-md-3"><input name="name" class="form-control" required placeholder="Customer name"/></div><div class="col-md-2"><input name="accountNumber" class="form-control" required placeholder="Account"/></div><div class="col-md-4"><input name="address" class="form-control" placeholder="Address"/></div><div class="col-md-2"><input name="site" class="form-control" placeholder="Division / site"/></div><div class="col-md-1"><button class="btn btn-primary">Add</button></div></form></div></div><div class="card"><table class="table mb-0"><thead><tr><th>Customer</th><th>Account</th><th>Address</th><th>Site</th><th>Tyres</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Name</td><td>@c.AccountNumber</td><td>@c.Address</td><td>@c.Site</td><td>@c.Tyres.Count</td></tr>}</tbody></table></div>
