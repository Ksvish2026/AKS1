@{Layout=null;ViewData["Title"]="Sign in";}
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Sign in · AKS Tyre Production</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><style>*{box-sizing:border-box}body{min-height:100vh;margin:0;background:linear-gradient(135deg,#0d1b25,#203c4b);display:grid;place-items:center;font-family:"Segoe UI",sans-serif;color:#17212b}.login{width:min(430px,calc(100% - 32px));background:white;border-radius:14px;padding:34px;box-shadow:0 24px 70px #0006}.logo{width:58px;height:58px;background:#f5a623;border-radius:9px;display:grid;place-items:center;font-weight:900;font-size:20px;margin-bottom:20px}.login h2{font-size:28px;margin:0 0 6px}.subtitle{color:#6c7a89;margin:0 0 26px}.login label{display:block;font-weight:600;margin:0 0 7px}.login input:not([type=hidden]){display:block;width:100%;padding:12px 13px;border:1px solid #cfd7dd;border-radius:7px;font-size:16px;margin:0 0 17px}.login button{display:block;width:100%;border:0;border-radius:7px;background:#f5a623;padding:13px;font-size:16px;font-weight:700;cursor:pointer}.credentials{background:#f3f6f8;border:1px solid #e0e6ea;border-radius:8px;padding:12px;font-size:13px;margin-top:20px}.text-center{text-align:center;margin-top:16px}.login a{color:#176da0}.alert{background:#fbe7e7;color:#9b2424;padding:10px;border-radius:7px;margin-bottom:16px}</style></head><body><main class="login"><div class="logo">AKS</div><h2>Welcome back</h2><p class="subtitle">Sign in to the Tyre Production Tracking System</p>@if(ViewBag.Error!=null){<div class="alert">@ViewBag.Error</div>}<form method="post"><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/><label>Username</label><input name="username" autocomplete="username" autofocus required/><label>Password</label><input name="password" type="password" autocomplete="current-password" required/><button>Sign in</button></form><div class="credentials"><strong>Demo credentials</strong><br/>Username: Admin<br/>Password: Admin</div><div class="text-center"><a asp-controller="CustomerPortal" asp-action="Index">Open customer tyre tracking</a></div></main></body></html>
